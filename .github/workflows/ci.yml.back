name : CI

on: 
  push:
    branches: ["main"]
  pull_request: 
    branches: ["main"]
  workflow_dispatch:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: action/checkout@v7
      
      - name: Setup Python
        uses: action/setup-python@7
      
      - name: Run Tests
        run: uv sync && ./scripts/run-tests.sh
  
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: action/checkout@v7
      
      - name: Docker Buildx setup
        uses: docker/setup-buildx-action@v4

      
      